digraph CANN_Architecture {
    rankdir=TB;
    fontsize=12;
    fontname="Microsoft YaHei";
    node [shape=box fontname="Microsoft YaHei" fontsize=11 style=filled];
    edge [color="#555555"];
    labelloc="t";
    label="Ascend CANN 异构计算软件栈与生态层次图";

    // 顶层应用与框架
    subgraph cluster_app {
        label="异构AI应用层";
        style="rounded,filled";
        color="#8888aa";
        fillcolor="#eef1ff";

        app_infer   [label="推理应用"                fillcolor="#ffffff"];
        app_train   [label="AI框架与训练"            fillcolor="#ffffff"];
        mindspore   [label="MindSpore"              fillcolor="#d9e8ff"];
        pytorch     [label="PyTorch"                fillcolor="#d9e8ff"];
        tensorflow  [label="TensorFlow"             fillcolor="#d9e8ff"];
        caffe       [label="Caffe"                  fillcolor="#d9e8ff"];
        mindstudio  [label="MindStudio\n全流程开发平台" fillcolor="#ffd7a8"];

        app_train -> mindspore;
        app_train -> pytorch;
        app_train -> tensorflow;
        app_train -> caffe;
    }

    // AscendCL 接口
    subgraph cluster_ascendcl {
        label="昇腾计算语言（AscendCL）接口 ";
        style="rounded,filled";
        color="#66a0b8";
        fillcolor="#e5f3f7";

        ascendcl [label="算子/模型/应用开发接口" fillcolor="#ffffff"];
    }

    // 服务层
    subgraph cluster_service {
        label="异腾计算服务层 (Service Layer)";
        style="rounded,filled";
        color="#5c9d63";
        fillcolor="#ecf7ed";

        aol_lib [label="异腾算子库 (AOL)"          fillcolor="#ffffff"];
        nn_lib [label="NN 库"                    fillcolor="#ffffff"];
        blas_lib [label="BLAS 库"                    fillcolor="#ffffff"];
        dvpp_lib [label="DVPP 库"                 fillcolor="#ffffff"];
        aipp_lib [label="AIPP 库"                 fillcolor="#ffffff"];
        hccl_lib  [label="HCCL 库"                 fillcolor="#ffffff"];

        aoe     [label="异腾调优引擎 (AOE)"        fillcolor="#d7f2da"];
        opat    [label="OPAT\nOperator Auto Tune"  fillcolor="#f7ffe0"];
        amct    [label="AMCT\nModel Compression"   fillcolor="#f7ffe0"];
        sgat    [label="SGAT\nSubGraph Auto Tune"  fillcolor="#f7ffe0"];
        gdat    [label="GDAT\nGradient Auto Tune"  fillcolor="#f7ffe0"];
        adaptor [label="框架适配器\n(Framework Adaptor)" fillcolor="#ffffff"];

        aoe -> opat;
        aoe -> amct;
        aoe -> sgat;
        aoe -> gdat;
    }

    // 编译层
    subgraph cluster_compilation {
        label="异腾计算编译层 (Compilation Layer)";
        style="rounded,filled";
        color="#b8893a";
        fillcolor="#fdf4e3";

        atc        [label="ATC\nAscend Tensor Compiler" fillcolor="#ffffff"];
        graph_comp [label="图编译器 (Graph Compiler)"   fillcolor="#fff4d4"];
        tbe        [label="TBE (DSL/TIK)\nTensor Boost Engine" fillcolor="#fff4d4"];
    }

    // 执行层
    subgraph cluster_execution {
        label="异腾计算执行层 (Execution Layer)";
        style="rounded,filled";
        color="#c26363";
        fillcolor="#fdeeee";

        runtime    [label="运行管理器 (Runtime)"      fillcolor="#ffffff"];
        hccl       [label="HCCL\n通信库"             fillcolor="#ffe3e3"];
        graph_exec [label="图执行器 (Graph Executor)" fillcolor="#ffe3e3"];
        aipp       [label="AIPP\n预处理执行"         fillcolor="#fff5f5"];
        dvpp       [label="DVPP\n视频图像处理"       fillcolor="#fff5f5"];
        exec_ext   [label="..."                     fillcolor="#ffffff"];

        runtime    -> hccl;
        graph_exec -> aipp;
        graph_exec -> dvpp;
    }

    // 基础层
    subgraph cluster_base {
        label="异腾计算基础层 (Base Layer)";
        style="rounded,filled";
        color="#777777";
        fillcolor="#f2f2f2";

        abl      [label="ABL\nAscend Base Layer" fillcolor="#ffffff"];
        os       [label="OS"                    fillcolor="#ffffff"];
        svm      [label="SVM"                   fillcolor="#ffffff"];
        vm       [label="VM"                    fillcolor="#ffffff"];
        hdc      [label="HDC"                   fillcolor="#ffffff"];
        base_ext [label="..."                   fillcolor="#ffffff"];

        abl -> os;
        abl -> svm;
        abl -> vm;
        abl -> hdc;
    }

    // 芯片资源
    subgraph cluster_hardware {
        label="异腾芯片计算资源 (Processors)";
        style="rounded,filled";
        color="#444c7a";
        fillcolor="#e5e6f5";

        ascend310 [label="Ascend310" fillcolor="#ffffff"];
        ascend710 [label="Ascend710" fillcolor="#ffffff"];
        ascend910 [label="Ascend910" fillcolor="#ffffff"];
        hw_more   [label="..."       fillcolor="#ffffff"];
    }

    // 层间主链路（简单自上而下）

}