digraph Case8SystemArch {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.18",
    nodesep="0.35",
    ranksep="0.45",
    fontname="Noto Sans CJK SC",
    labelloc="t",
    label="case8 deployment overview"
  ];
  node [
    shape=box,
    style="rounded,filled",
    color="#415a77",
    fillcolor="#f7f9fc",
    fontname="Noto Sans CJK SC",
    fontsize=12,
    margin="0.10,0.07"
  ];
  edge [
    color="#415a77",
    fontname="Noto Sans CJK SC",
    fontsize=11,
    arrowsize=0.7
  ];

  prepare [label="PC / GPU\n.pt -> ONNX\nlabels + metadata"];
  convert [label="Ascend 310B\nATC\nONNX -> OM"];
  runtime [label="Ascend 310B runtime\ncamera + ACL OM\npostprocess + draw"];
  browser [label="Browser\nWebRTC H.264\nlive preview + stats"];

  prepare -> convert [label="copy ONNX"];
  convert -> runtime [label="load OM"];
  runtime -> browser [label="stream"];
}
