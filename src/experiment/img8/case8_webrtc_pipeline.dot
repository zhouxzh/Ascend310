digraph Case8WebrtcPipeline {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.18",
    nodesep="0.35",
    ranksep="0.45",
    fontname="Noto Sans CJK SC",
    labelloc="t",
    label="case8 WebRTC runtime flow"
  ];
  node [
    shape=box,
    style="rounded,filled",
    color="#3a506b",
    fillcolor="#f7f9fc",
    fontname="Noto Sans CJK SC",
    fontsize=12,
    margin="0.10,0.07"
  ];
  edge [
    color="#3a506b",
    fontname="Noto Sans CJK SC",
    fontsize=11,
    arrowsize=0.7
  ];

  capture [label="Camera\nOpenCV or DVPP\nBGR frame"];
  infer [label="YOLO detector\nletterbox 640\nACL OM inference"];
  draw [label="Postprocess\nscale boxes to original\nBGR -> NV12"];
  encode [label="CANN VENC\nH.264"];
  browser [label="Browser\nvideo + stats"];

  capture -> infer [label="latest frame"];
  infer -> draw [label="detections"];
  capture -> draw [label="original frame"];
  draw -> encode -> browser;
}
