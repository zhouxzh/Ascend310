digraph Case8ModelConversion {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.2",
    nodesep="0.4",
    ranksep="0.5",
    fontname="Noto Sans CJK SC"
  ];
  node [
    shape=box,
    style="rounded,filled",
    fontname="Noto Sans CJK SC",
    fontsize=11,
    margin="0.12,0.08"
  ];
  edge [
    fontname="Noto Sans CJK SC",
    fontsize=10,
    arrowsize=0.8
  ];

  subgraph cluster_pc {
    label="PC / GPU 工作站";
    fontsize=11; style="rounded,dashed"; color="#1a56db"; bgcolor="#f0f4ff";

    weights [label="HaGRIDv2 权重\n.pt 文件", fillcolor="#dbeafe", width=1.6];
    export [label="export_yolo_to_onnx.py\nUltralytics 导出\nonnx.checker 校验", fillcolor="#bfdbfe", width=1.8];
    onnx [label="ONNX 模型\n_labels.txt\n_metadata.json", fillcolor="#93c5fd", width=1.8];
    validate [label="ONNX Runtime\nCPU 功能验证\n（可选）", fillcolor="#dbeafe", width=1.5];

    weights -> export -> onnx;
    onnx -> validate [style=dashed, color="#6b7280"];
  }

  subgraph cluster_310b {
    label="昇腾 310B";
    fontsize=11; style="rounded,dashed"; color="#047857"; bgcolor="#ecfdf5";

    atc [label="ATC 转换\natc_convert.sh\nAscend310B4", fillcolor="#d1fae5", width=1.6];
    om [label="OM 离线模型\nNPU 推理", fillcolor="#a7f3d0", width=1.6];

    atc -> om;
  }

  onnx -> atc [label="rsync 同步\nONNX + 元数据", color="#1a56db"];
}
