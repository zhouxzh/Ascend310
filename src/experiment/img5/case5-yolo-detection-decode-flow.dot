digraph Case5YoloDetectionDecodeFlow {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.22",
    nodesep="0.30",
    ranksep="0.48",
    splines=polyline,
    fontname="Microsoft YaHei",
    dpi=150
  ];
  node [shape=box, style="rounded,filled", fontname="Microsoft YaHei", fontsize=11,
        color="#374151", fontcolor="#111827", fillcolor="#f8fafc", margin="0.14,0.09"];
  edge [fontname="Microsoft YaHei", fontsize=9, color="#475569", arrowsize=0.75];

  manifest [shape=note, label="accepted manifest\nimages / [1,3,1024,1024] / 51 评分通道\n预处理与模型哈希已核验", fillcolor="#f3e8ff", color="#CC79A7"];
  preprocess [label="CPU: FFTW 时频预处理\nCU8 -> Blackman -> 功率 -> dB/黑热 -> RGB\nfloat32 [1,3,1024,1024]", fillcolor="#e0f2fe", color="#56B4E9"];
  om [label="NPU: AscendOmRunner\nTorchSig YOLO11s OM 推理\n输入名 images", fillcolor="#dcfce7", color="#009E73"];
  raw_output [label="NPU 输出 output0\nfloat32 [1,55,21504]", fillcolor="#dcfce7", color="#009E73"];
  orient [label="CPU: 规范化输出方向\nsqueeze: [55,21504]\n转置: [21504,55]", fillcolor="#e0f2fe", color="#56B4E9"];
  candidates [label="CPU: 候选解码\n每行 = xywh(4) + 51 个评分通道\nargmax 得预测通道与置信度", fillcolor="#e0f2fe", color="#56B4E9"];
  threshold [shape=diamond, label="置信度 >= 0.25\n且宽、高 > 0？", fillcolor="#fff7ed", color="#E69F00"];
  nms [label="CPU: 按预测通道分组 NMS\n同组按分数降序，IoU <= 0.70\n最多保留 300 个", fillcolor="#e0f2fe", color="#56B4E9"];
  results [shape=note, label="候选区域结果\nbox_xyxy / class_index / label / confidence\nsingle_cls 权重不能作 51 类识别", fillcolor="#f3e8ff", color="#CC79A7"];
  discard [label="丢弃该候选", fillcolor="#fee2e2", color="#D55E00"];
  unavailable [label="启动时 NPU unavailable\n入口拒绝；不以 CPU 检测替代", fillcolor="#fee2e2", color="#D55E00"];
  failed [label="执行期错误\n记录 failed/error 并终止本次 run\n不以 CPU 检测替代", fillcolor="#fee2e2", color="#D55E00"];

  { rank=same; raw_output; failed; }
  { rank=same; discard; nms; }

  manifest -> preprocess [label="允许实时入口", color="#CC79A7", fontcolor="#CC79A7"];
  preprocess -> om;
  om -> raw_output;
  manifest -> unavailable [label="启动预检失败", style=dashed, color="#D55E00", fontcolor="#D55E00", constraint=false];
  om -> failed [label="执行、NaN/Inf 或形状错误", style=dashed, color="#D55E00", fontcolor="#D55E00"];
  raw_output -> orient -> candidates -> threshold;
  threshold -> nms [label="是"];
  threshold -> discard [label="否", style=dashed, color="#D55E00", fontcolor="#D55E00"];
  nms -> results;
}
