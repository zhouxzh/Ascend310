digraph Case1Flow {
    graph [
        rankdir=LR,
        newrank=true,
        fontname="Microsoft YaHei",
        fontsize=15,
        label="案例1：FastAPI、React 与昇腾 NPU 的数据流",
        labelloc=t,
        nodesep=0.28,
        ranksep=0.60,
        splines=polyline,
        bgcolor="#FFFFFF"
    ]
    node [
        shape=box,
        style="filled,rounded",
        fontname="Microsoft YaHei",
        fontsize=11,
        color="#333333",
        margin="0.12,0.08"
    ]
    edge [fontname="Microsoft YaHei", fontsize=9, color="#4D4D4D"]

    H1 [shape=plaintext, fontname="Microsoft YaHei", fontsize=13, fontcolor="#0072B2", label="① 生命周期"]
    H2 [shape=plaintext, fontname="Microsoft YaHei", fontsize=13, fontcolor="#E69F00", label="② 服务与界面"]
    H3 [shape=plaintext, fontname="Microsoft YaHei", fontsize=13, fontcolor="#009E73", label="③ 采集与队列"]
    H4 [shape=plaintext, fontname="Microsoft YaHei", fontsize=13, fontcolor="#CC79A7", label="④ 模型执行"]
    H5 [shape=plaintext, fontname="Microsoft YaHei", fontsize=13, fontcolor="#56B4E9", label="⑤ 比对与事件"]

    Start [shape=oval, fillcolor="#0072B2", fontcolor=white, label="启动"]
    Init [fillcolor="#56B4E9", label="FastAPI lifespan\n数据库与运行时"]
    Ready [shape=diamond, fillcolor="#F0E442", label="模型与摄像头\n是否就绪？"]
    Degraded [fillcolor="#E69F00", label="降级状态\n推理接口 503"]
    Stop [shape=diamond, fillcolor="#F0E442", label="收到退出信号？"]
    Release [fillcolor="#999999", fontcolor=white, label="停止摄像头与流\n释放 OM、buffer、ACL"]
    End [shape=oval, fillcolor="#0072B2", fontcolor=white, label="结束"]

    React [fillcolor="#E69F00", label="React 界面\n注册、抓拍、打卡"]
    Validate [fillcolor="#E69F00", label="FastAPI 校验\n类型、大小、路径"]
    Response [fillcolor="#56B4E9", label="JSON 响应\n结果或错误"]

    Camera [fillcolor="#009E73", fontcolor=white, label="摄像头帧"]
    Cache [fillcolor="#009E73", fontcolor=white, label="JPEG 缓存"]
    Queue [fillcolor="#F0E442", label="单一硬件队列\n串行提交任务"]

    Detect [fillcolor="#CC79A7", fontcolor=white, label="检测 OM\n640×640"]
    Crop [fillcolor="#56B4E9", label="最大框裁剪\n边界约束"]
    Feature [fillcolor="#D55E00", fontcolor=white, label="特征 OM\n112×112"]

    Vectors [fillcolor="#56B4E9", label="SQLite\n用户向量"]
    Similarity [fillcolor="#56B4E9", label="余弦相似度\n最高候选"]
    Decision [shape=diamond, fillcolor="#F0E442", label="超过阈值？"]
    Event [fillcolor="#009E73", fontcolor=white, label="考勤事件\n已知用户或教学登记"]

    {rank=same; H1; Start; Init; Ready; Stop; Release; End}
    {rank=same; H2; React; Validate; Response; Degraded}
    {rank=same; H3; Camera; Cache; Queue}
    {rank=same; H4; Detect; Crop; Feature}
    {rank=same; H5; Vectors; Similarity; Decision; Event}

    H1 -> H2 [style=invis, weight=100]
    H2 -> H3 [style=invis, weight=100]
    H3 -> H4 [style=invis, weight=100]
    H4 -> H5 [style=invis, weight=100]

    Start -> Init [constraint=false]
    Init -> Ready [constraint=false]
    Ready -> React [label="是", constraint=false]
    Ready -> Degraded [label="否", constraint=false]
    Degraded -> React [style=dashed, label="页面可用", constraint=false]
    React -> Validate [label="HTTP", constraint=false]
    Validate -> Queue [label="注册/打卡", constraint=false]
    Queue -> Detect [constraint=false]
    Detect -> Crop [constraint=false]
    Crop -> Feature [constraint=false]
    Feature -> Vectors [constraint=false]
    Vectors -> Similarity [constraint=false]
    Similarity -> Decision [constraint=false]
    Decision -> Event [label="是；或自动登记", constraint=false]
    Decision -> Response [label="否：手动请求", constraint=false]
    Event -> Response [constraint=false]
    Response -> React [style=dashed, label="JSON", constraint=false]

    Init -> Camera [style=dashed, label="启动采集", constraint=false]
    Camera -> Cache [constraint=false]
    Cache -> Queue [style=dashed, label="自动考勤", constraint=false]
    Cache -> React [style=dashed, label="MJPEG", constraint=false]

    Init -> Stop [style=dashed, constraint=false]
    Stop -> Camera [label="否", style=dashed, constraint=false]
    Stop -> Release [label="是", constraint=false]
    Release -> End [constraint=false]
}
