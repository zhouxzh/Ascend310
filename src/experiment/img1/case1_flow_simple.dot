digraph Case1FlowSimple {
    graph [
        rankdir=TB,
        fontname="Microsoft YaHei",
        fontsize=14,
        label="案例1：边缘人脸考勤的 FastAPI—NPU 流程",
        labelloc=t,
        nodesep=0.55,
        ranksep=0.65,
        bgcolor="#FFFFFF"
    ]

    node [
        shape=box,
        style="filled,rounded",
        fontname="Microsoft YaHei",
        fontsize=12,
        color="#333333"
    ]
    edge [fontname="Microsoft YaHei", fontsize=10, color="#4D4D4D"]

    Start [shape=oval, fillcolor="#0072B2", fontcolor=white, label="服务启动"]
    Init [fillcolor="#56B4E9", label="FastAPI lifespan\n数据库、模型与运行时检查"]
    UI [fillcolor="#E69F00", label="React 界面\n注册、抓拍、手动打卡、记录"]
    Camera [fillcolor="#009E73", fontcolor=white, label="摄像头采集\n维护最近帧"]
    Queue [fillcolor="#F0E442", label="单一硬件工作队列\n串行访问摄像头与 NPU"]
    Detect [fillcolor="#CC79A7", fontcolor=white, label="检测模型\n缩放、推理、后处理"]
    Embed [fillcolor="#D55E00", fontcolor=white, label="特征模型\n对齐、推理、输出向量"]
    Match [fillcolor="#56B4E9", label="余弦相似度\n与 SQLite 用户向量比对"]
    Record [fillcolor="#009E73", fontcolor=white, label="考勤事件\nSQLite 本地保存"]
    Stream [fillcolor="#E69F00", label="JPEG 缓存\nMJPEG 预览"]
    Health [fillcolor="#F0E442", label="API 响应\nready / degraded / 业务结果"]
    Stop [fillcolor="#999999", fontcolor=white, label="停止任务、摄像头、模型与 ACL"]
    End [shape=oval, fillcolor="#0072B2", fontcolor=white, label="服务结束"]

    Start -> Init
    Init -> Queue
    Init -> UI [style=dashed, label="静态资源"]
    Queue -> Camera
    Camera -> Queue [label="当前帧"]
    Queue -> Detect
    Detect -> Embed [label="检测到人脸"]
    Detect -> Camera [style=dashed, label="无人脸或无效框"]
    Embed -> Match
    Match -> Record [label="注册或匹配通过"]
    Match -> Health [label="未匹配 / 错误"]
    Record -> Health
    Camera -> Stream [style=dashed, label="JPEG 缓存"]
    Stream -> UI [style=dashed, label="/video_feed"]
    UI -> Queue [style=dashed, label="HTTP 任务"]
    Health -> UI [style=dashed, constraint=false]
    Init -> Stop [style=dashed, label="退出信号"]
    Stop -> End
}
