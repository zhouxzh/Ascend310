digraph MindSporeAscendStack {
    graph [
        rankdir=TB,
        bgcolor="transparent",
        dpi=300,
        pad=0.25,
        nodesep=0.45,
        ranksep=0.55
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Noto Sans CJK SC",
        fontsize=18,
        margin="0.20,0.13",
        penwidth=2
    ];

    edge [
        color="#455A64",
        penwidth=2.4,
        arrowsize=0.8
    ];

    user_code [
        label="用户代码\nTensor / Cell / ops / Dataset",
        fillcolor="#E3F2FD",
        color="#1565C0",
        fontcolor="#0D47A1"
    ];

    mindspore_frontend [
        label="MindSpore 前端\n自动微分、图编译、优化",
        fillcolor="#E8F5E9",
        color="#2E7D32",
        fontcolor="#1B5E20"
    ];

    mindir [
        label="MindIR / 算子图",
        fillcolor="#FFF8E1",
        color="#F9A825",
        fontcolor="#6D4C41"
    ];

    cann [
        label="CANN\nGE 图引擎、算子库、Runtime、AscendCL",
        fillcolor="#FFF3E0",
        color="#EF6C00",
        fontcolor="#E65100"
    ];

    driver [
        label="NPU 驱动与固件",
        fillcolor="#FCE4EC",
        color="#C62828",
        fontcolor="#B71C1C"
    ];

    hardware [
        label="Ascend 310B 硬件\nAI Core、DVPP、内存",
        fillcolor="#E8EAF6",
        color="#3949AB",
        fontcolor="#283593"
    ];

    user_code -> mindspore_frontend -> mindir -> cann -> driver -> hardware;
}
