digraph venc_encode_flow {
    graph [
        rankdir=LR,
        bgcolor="transparent",
        dpi=300,
        pad=0.2,
        nodesep=0.5,
        ranksep=0.55
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Noto Sans CJK SC",
        fontsize=18,
        margin="0.18,0.12",
        penwidth=2
    ];

    edge [
        color="#455A64",
        penwidth=2.2,
        arrowsize=0.8
    ];

    src [
        label="原始帧\nBGR ndarray / NV12",
        fillcolor="#E8EAF6",
        color="#3949AB",
        fontcolor="#1A237E"
    ];

    nv12 [
        label="bgr_to_nv12()\n转换为 NV12",
        fillcolor="#FFF8E1",
        color="#F9A825",
        fontcolor="#E65100"
    ];

    send [
        label="acl.media.venc_send_frame()\n发送到 VENC 通道",
        fillcolor="#E8F5E9",
        color="#2E7D32",
        fontcolor="#1B5E20"
    ];

    callback [
        label="VENC 回调\n编码完成通知",
        fillcolor="#E8F5E9",
        color="#2E7D32",
        fontcolor="#1B5E20"
    ];

    out [
        label="H.264 码流\nAnnex-B 格式",
        fillcolor="#FCE4EC",
        color="#C62828",
        fontcolor="#B71C1C"
    ];

    src -> nv12 -> send -> callback -> out;
}
