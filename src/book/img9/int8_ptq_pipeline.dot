digraph int8_ptq_pipeline {
    graph [
        rankdir=LR,
        bgcolor="transparent",
        dpi=300,
        pad=0.22,
        nodesep=0.42,
        ranksep=0.55
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Noto Sans CJK SC",
        fontsize=18,
        margin="0.18,0.12",
        penwidth=2
    ];

    edge [
        color="#455A64",
        penwidth=2.1,
        arrowsize=0.8
    ];

    input [
        label="FP32 ONNX\n+ PNG 校准集",
        fillcolor="#E8EAF6",
        color="#3949AB",
        fontcolor="#1A237E"
    ];

    prepare [
        label="03_prepare_quantization.py\nopset 转换 / 生成 config",
        fillcolor="#E3F2FD",
        color="#1976D2",
        fontcolor="#0D47A1"
    ];

    calibrate [
        label="04_calibrate_quantization.py\n收集激活范围 / 冻结 deploy ONNX",
        fillcolor="#FFF8E1",
        color="#F9A825",
        fontcolor="#E65100"
    ];

    deploy [
        label="INT8 deploy ONNX\n包含量化参数",
        fillcolor="#E8F5E9",
        color="#2E7D32",
        fontcolor="#1B5E20"
    ];

    atc [
        label="ATC 转换\nINT8 OM",
        fillcolor="#FCE4EC",
        color="#C62828",
        fontcolor="#B71C1C"
    ];

    input -> prepare -> calibrate -> deploy -> atc;
}
