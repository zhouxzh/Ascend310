digraph chapter8_outputs {
    graph [
        rankdir=TB,
        bgcolor="transparent",
        dpi=300,
        pad=0.2,
        nodesep=0.45,
        ranksep=0.5
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Noto Sans CJK SC",
        fontsize=18,
        margin="0.18,0.12",
        penwidth=2
    ];

    edge [
        color="#455A64",
        penwidth=2.0,
        arrowsize=0.75
    ];

    outputs [
        label="outputs/",
        fillcolor="#263238",
        color="#263238",
        fontcolor="#FFFFFF"
    ];

    output_compare [
        label="output_compare.json\nFP16 输出对齐",
        fillcolor="#E8F5E9",
        color="#2E7D32",
        fontcolor="#1B5E20"
    ];

    output_compare_int8 [
        label="output_compare_int8.json\nINT8 输出对齐",
        fillcolor="#E8F5E9",
        color="#2E7D32",
        fontcolor="#1B5E20"
    ];

    perf [
        label="perf_compare.json\n三模型性能对比",
        fillcolor="#E3F2FD",
        color="#1976D2",
        fontcolor="#0D47A1"
    ];

    accuracy [
        label="accuracy_compare.json\n三模型完整验证集 accuracy",
        fillcolor="#FCE4EC",
        color="#C62828",
        fontcolor="#B71C1C"
    ];

    sweep [
        label="calibration_sweep/\n校准样本数 sweep",
        fillcolor="#F3E5F5",
        color="#8E24AA",
        fontcolor="#4A148C"
    ];

    summary [
        label="summary.csv\n样本数-精度汇总",
        fillcolor="#FFF8E1",
        color="#F9A825",
        fontcolor="#E65100"
    ];

    reports [
        label="samples_*/accuracy_compare.json\n每个样本点的验证报告",
        fillcolor="#FFF8E1",
        color="#F9A825",
        fontcolor="#E65100"
    ];

    outputs -> output_compare;
    outputs -> output_compare_int8;
    outputs -> perf;
    outputs -> accuracy;
    outputs -> sweep;
    sweep -> summary;
    sweep -> reports;
}
