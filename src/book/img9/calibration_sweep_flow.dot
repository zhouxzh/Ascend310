digraph calibration_sweep_flow {
    graph [
        rankdir=LR,
        bgcolor="transparent",
        dpi=300,
        pad=0.22,
        nodesep=0.42,
        ranksep=0.55
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Noto Sans CJK SC",
        fontsize=18,
        margin="0.18,0.12",
        penwidth=2
    ];

    edge [
        color="#455A64",
        penwidth=2.1,
        arrowsize=0.8
    ];

    subset [
        label="生成 calib_sweep_N.txt\n固定随机种子抽样",
        fillcolor="#E8EAF6",
        color="#3949AB",
        fontcolor="#1A237E"
    ];

    prepare [
        label="03_prepare_quantization.py\n生成 AMCT 配置",
        fillcolor="#E3F2FD",
        color="#1976D2",
        fontcolor="#0D47A1"
    ];

    calibrate [
        label="04_calibrate_quantization.py\n按 N 张图片校准",
        fillcolor="#FFF8E1",
        color="#F9A825",
        fontcolor="#E65100"
    ];

    atc [
        label="ATC 转 int8_sN.om\n每个 N 独立模型",
        fillcolor="#E8F5E9",
        color="#2E7D32",
        fontcolor="#1B5E20"
    ];

    validate [
        label="05_validate_accuracy.py\n完整验证集评估",
        fillcolor="#FCE4EC",
        color="#C62828",
        fontcolor="#B71C1C"
    ];

    summary [
        label="追加 summary.csv\n绘制样本数-精度曲线",
        fillcolor="#F3E5F5",
        color="#8E24AA",
        fontcolor="#4A148C"
    ];

    subset -> prepare -> calibrate -> atc -> validate -> summary;
}
