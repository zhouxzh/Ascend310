digraph ATC_Flow {
	rankdir=TB;
	fontsize=12;
	fontname="Microsoft YaHei";
	node [shape=box fontname="Microsoft YaHei" fontsize=11 style=filled];
	edge [color="#666666"];
	labelloc="t";
	label="ATC 流程与图优化";

	// 顶部：框架输入与单算子描述
	subgraph cluster_F {
		label="框架输入";
		style="rounded,filled";
		color="#7aa3e5";
		fillcolor="#d9e8ff";

		Caffe     [label="Caffe"        fillcolor="#ffffff"];
		TF        [label="TensorFlow"   fillcolor="#ffffff"];
		ONNX      [label="ONNX"         fillcolor="#ffffff"];
		MS        [label="MindSpore"    fillcolor="#ffffff"];
		OpDesc    [label="基于 Ascend IR 定义的\n单算子描述文件" fillcolor="#dff7f0" color="#59c3a6"];
	}

	// ATC 工具与其内部模块
	subgraph cluster_atc {
		label="ATC 工具";
		style="rounded,filled";
		color="#7aa3e5";
		fillcolor="#f5f8ff";

		// 解析器
		subgraph cluster_P {
			label="解析器";
			style="rounded,filled";
			color="#7aa3e5";
			fillcolor="#eaf2ff";

			CaffeParser [label="Caffe Parser" fillcolor="#ffffff"];
			TFParser    [label="TF Parser"    fillcolor="#ffffff"];
			ONNXParser  [label="ONNX Parser"  fillcolor="#ffffff"];
		}

		// 框架到解析器映射
		Caffe -> CaffeParser;
		TF    -> TFParser;
		ONNX  -> ONNXParser;

		// 统一中间图
		IR [label="统一中间IR Graph" fillcolor="#e6f7ff" color="#4db3ff"];
		CaffeParser -> IR;
		TFParser    -> IR;
		ONNXParser  -> IR;
		MS          -> IR;

		// Graph Optimizer 主流程
		subgraph cluster_GO {
			label="Graph Optimizer";
			style="rounded,filled";
			color="#d8a657";
			fillcolor="#fff3d6";

			GP    [label="图准备" fillcolor="#fffdf3"];
			GPart [label="图拆分" fillcolor="#fffdf3"];
			GOpt  [label="图优化" fillcolor="#fffdf3"];
			GComp [label="图编译" fillcolor="#fffdf3"];

			GP -> GPart -> GOpt -> GComp;
		}

		IR -> GP;

		// 单算子链路
		subgraph cluster_OP {
			label="单算子链路";
			style="rounded,filled";
			color="#59c3a6";
			fillcolor="#dff7f0";

			OpCompile [label="单算子编译" fillcolor="#ffffff"];
		}
	}

	// 产物：离线模型 OM
	OM [label="离线模型（.om）" fillcolor="#fff0cc" color="#d8a657"];
	GComp     -> OM;
	OpCompile -> OM;

	// 下游执行
	Infer        [label="执行推理"       fillcolor="#e8ffe8" color="#76c776"];
	KernelVerify [label="执行单算子验证" fillcolor="#e8ffe8" color="#76c776"];
	OM -> Infer;
	OM -> KernelVerify;

	// 跨集群边：单算子描述到编译
	OpDesc -> OpCompile;
}

