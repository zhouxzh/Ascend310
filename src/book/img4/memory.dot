digraph G {
    rankdir=TB; 
    fontname="Noto Serif SC";
    splines=ortho;


    // 默认节点样式：圆角矩形，柔和填充，灰色边框
    node [fontname="Noto Serif SC", fontsize=11, style="filled,rounded", shape=box, penwidth=1.5, color="#757575", fillcolor="#FFFFFF"];
    edge [fontname="Noto Serif SC", fontsize=10, color="#666666", penwidth=1.2];

    // --- 1. 资源申请与准备 (最左侧) ---
    subgraph cluster_prep {
        style=invis;
        // 资源节点使用 Note 形状
        node [shape=note, style="filled", width=1.3];
        
        node_alloc_host [label="申请Host内存\nacl.rt.malloc_host", fillcolor="#C8E6C9", color="#2E7D32"]; // 绿色系
        node_alloc_device [label="申请Device内存\nacl.rt.malloc", fillcolor="#BBDEFB", color="#1565C0"]; // 蓝色系
        
        // 数据读入
        node_load_data [label="读入数据\n(User Logic)", shape=box, style="dashed,filled", fillcolor="#FFF9C4", color="#FBC02D"]; // 黄色系
    }

    // --- 2. 场景选择 ---
    // 决策节点使用菱形
    node_scenario_switch [label="选择传输\n场景?", shape=diamond, style="filled", fillcolor="#FFE0B2", color="#EF6C00", height=1.2]; // 橙色系

    // --- 3. 四种传输分支 (中间层) ---
    // 使用 subgraph 将每种逻辑聚类，背景轻微灰底

    // --> H2H (Host to Host)
    subgraph cluster_h2h {
        label="Host ↔ Host"; fontcolor="#616161"; style="dashed,rounded"; bgcolor="#FAFAFA"; color="#E0E0E0";
        node_h2h_sync [label="同步复制\nacl.rt.memcpy\n(HostToHost)", fillcolor="#FFFFFF"];
    }

    // --> H2D (Host to Device)
    subgraph cluster_h2d {
        label="Host → Device"; fontcolor="#616161"; style="dashed,rounded"; bgcolor="#FAFAFA"; color="#E0E0E0";
        node_h2d_mode [label="模式?", shape=diamond, height=0.6, fillcolor="#B2EBF2", color="#0097A7"];
        
        node_h2d_sync [label="同步复制\n(HostToDevice)", fillcolor="#FFFFFF"];
        
        // 异步链
        node_h2d_align [label="Host内存\n64字节对齐", fillcolor="#F8BBD0", color="#C2185B"]; // 粉红警告色
        node_h2d_stream [label="创建Stream", fillcolor="#E0F7FA", color="#006064"]; // 青色系
        node_h2d_async [label="异步复制\nmemcpy_async", fillcolor="#FFFFFF"];
        node_h2d_wait [label="等待同步\nsynchronize", fillcolor="#E0F7FA", color="#006064"];
    }

    // --> D2H (Device to Host)
    subgraph cluster_d2h {
        label="Device → Host"; fontcolor="#616161"; style="dashed,rounded"; bgcolor="#FAFAFA"; color="#E0E0E0";
        node_d2h_mode [label="模式?", shape=diamond, height=0.6, fillcolor="#B2EBF2", color="#0097A7"];

        node_d2h_sync [label="同步复制\n(DeviceToHost)", fillcolor="#FFFFFF"];

        // 异步链
        node_d2h_align [label="Host内存\n64字节对齐", fillcolor="#F8BBD0", color="#C2185B"];
        node_d2h_stream [label="创建Stream", fillcolor="#E0F7FA", color="#006064"];
        node_d2h_async [label="异步复制\nmemcpy_async", fillcolor="#FFFFFF"];
        node_d2h_wait [label="等待同步\nsynchronize", fillcolor="#E0F7FA", color="#006064"];
    }

    // --> D2D (Device to Device)
    subgraph cluster_d2d {
        label="Device ↔ Device"; fontcolor="#616161"; style="dashed,rounded"; bgcolor="#FAFAFA"; color="#E0E0E0";
        node_d2d_mode [label="模式?", shape=diamond, height=0.6, fillcolor="#B2EBF2", color="#0097A7"];

        node_d2d_sync [label="同步复制\n(DeviceToDevice)", fillcolor="#FFFFFF"];
        
        node_d2d_stream [label="创建Stream", fillcolor="#E0F7FA", color="#006064"];
        node_d2d_async [label="异步复制\nmemcpy_async", fillcolor="#FFFFFF"];
        node_d2d_wait [label="等待同步\nsynchronize", fillcolor="#E0F7FA", color="#006064"];
    }

    // --- 4. 资源清理 (最右侧) ---
    subgraph cluster_cleanup {
        style=invis;
        node [shape=note, style="filled", width=1.5];
        
        node_destroy_stream [label="销毁Stream\nacl.rt.destroy_stream", fillcolor="#E0F7FA", color="#006064"];
        
        node_free_host [label="释放Host\nacl.rt.free_host", fillcolor="#FFCCBC", color="#D84315"]; // 深橙色系
        node_free_device [label="释放Device\nacl.rt.free", fillcolor="#FFCCBC", color="#D84315"];
    }

    // --- 连线逻辑 ---

    // 准备阶段
    node_alloc_host -> node_load_data;
    node_alloc_device -> node_load_data;
    node_load_data -> node_scenario_switch;

    // 分支路由
    node_scenario_switch -> node_h2h_sync [xlabel="H2H"];

    node_scenario_switch -> node_h2d_mode [xlabel="H2D"];
    node_h2d_mode -> node_h2d_sync [xlabel="Sync"];
    node_h2d_mode -> node_h2d_align [xlabel="Async"];
    node_h2d_align -> node_h2d_stream -> node_h2d_async -> node_h2d_wait;

    node_scenario_switch -> node_d2h_mode [xlabel="D2H"];
    node_d2h_mode -> node_d2h_sync [xlabel="Sync"];
    node_d2h_mode -> node_d2h_align [xlabel="Async"];
    node_d2h_align -> node_d2h_stream -> node_d2h_async -> node_d2h_wait;

    node_scenario_switch -> node_d2d_mode [xlabel="D2D"];
    node_d2d_mode -> node_d2d_sync [xlabel="Sync"];
    node_d2d_mode -> node_d2d_stream [xlabel="Async"];
    node_d2d_stream -> node_d2d_async -> node_d2d_wait;

    // 汇聚清理
    // 异步任务 -> 销毁流
    node_h2d_wait -> node_destroy_stream;
    node_d2h_wait -> node_destroy_stream;
    node_d2d_wait -> node_destroy_stream;

    // 所有任务 -> 释放内存 (使用虚线连接以减少混乱，表示逻辑顺序)
    node_h2h_sync -> node_free_host [constraint=false];
    node_h2d_sync -> node_free_host [constraint=false];
    node_d2h_sync -> node_free_host [constraint=false];
    
    node_destroy_stream -> node_free_host [color="#9E9E9E", style=dashed];
    node_free_host -> node_free_device [color="#9E9E9E", style=dashed]; // 强制布局排序

    // 布局辅助
    { rank=same; node_alloc_host; node_alloc_device }
    { rank=same; node_free_host; node_free_device }
}
