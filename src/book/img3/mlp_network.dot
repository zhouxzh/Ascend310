digraph MLP {
  rankdir=TB;
  splines=true;
  charset="UTF-8";
  fontname="Noto Sans SC";
  node [shape=circle, fontname="Noto Sans SC"];
  edge [fontname="Noto Sans SC"];

  // 输入层
  {
    rank=same;
    subgraph cluster_inputs {
      label="输入（8维）";
      style=dashed;
      color="#cccccc";

      longitude [label="经度"];
      latitude [label="纬度"];
      housingMedianAge [label="房龄中位数"];
      totalRooms [label="房间总数"];
      totalBedrooms [label="卧室总数"];
      population [label="人口"];
      households [label="家庭数"];
      medianIncome [label="收入中位数"];
      bias_h [label=<偏置 b<SUB>1</SUB>>, shape=diamond, style=filled, fillcolor="#f5f5f5"];
    }
  }

// 隐藏层
{
    rank=same;
    subgraph cluster_hidden {
        label="隐藏层 (ReLU)";
        style=dashed;
        color="#cccccc";
        
        // 添加不可见节点用于左右填充，使隐藏层在视觉上居中（输入层9个节点，隐藏层5个节点）
        h_pad_l1 [style=invis, label="", width=1.5];
        h_pad_l2 [style=invis, label="", width=1.5];
        
        h1 [label=<h<SUB>1</SUB>>];
        h2 [label=<h<SUB>2</SUB>>];
        h3 [label=<...>];
        h4 [label=<h<SUB>i</SUB>>];
        h5 [label=<...>];
        h6 [label=<h<SUB>n</SUB>>];
        bias_y [label=<偏置 b<SUB>2</SUB>>, shape=diamond, style=filled, fillcolor="#f5f5f5"];

        h_pad_r1 [style=invis, label="", width=0.5];
        h_pad_r2 [style=invis, label="", width=0.5];

        // 内部不可见连接以维持顺序和间距
        h_pad_l1 -> h_pad_l2 -> h1 -> h2 -> h3 -> h4 -> h5 -> h6 -> bias_y -> h_pad_r1 -> h_pad_r2 [style=invis];
    }
}



  // 输出层
  subgraph cluster_output {
    label="输出层";
    style=dashed;
    color="#cccccc";
    y [label="ŷ（房价中位数）", shape=circle, style=filled, fillcolor="#eef7ff"];
  }

  // 连接：输入层 -> 隐藏层
longitude -> latitude -> housingMedianAge -> totalRooms -> totalBedrooms -> population -> households -> medianIncome -> bias_h [style=invis];
{longitude latitude housingMedianAge totalRooms totalBedrooms population households medianIncome bias_h} -> {h1 h2 h3 h4 h5 h6} [color="#aaaaaa", weight=0.1];

  // 连接：隐藏层 -> 输出层
  {h1 h2 h3 h4 h5 h6 bias_y} -> y [color="#555555"];
}
