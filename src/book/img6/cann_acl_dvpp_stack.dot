digraph cann_acl_dvpp_stack {
    graph [
        rankdir=TB,
        bgcolor="transparent",
        dpi=300,
        pad=0.25,
        nodesep=0.55,
        ranksep=0.65
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Noto Sans CJK SC",
        fontsize=18,
        margin="0.18,0.12",
        penwidth=2
    ];

    edge [
        color="#455A64",
        penwidth=2.4,
        arrowsize=0.8
    ];

    app [
        label="Python 应用层\nacl.media, acl.rt",
        fillcolor="#E3F2FD",
        color="#1565C0",
        fontcolor="#0D47A1"
    ];

    acl [
        label="ACL C/C++ Runtime\nlibascendcl.so",
        fillcolor="#FFF3E0",
        color="#EF6C00",
        fontcolor="#E65100"
    ];

    driver [
        label="DVPP Driver\ndrv_venc, drv_dvpp_comm",
        fillcolor="#FCE4EC",
        color="#C62828",
        fontcolor="#B71C1C"
    ];

    hardware [
        label="Ascend 310B 硬件\nVENC / DVPP 模块",
        fillcolor="#E8F5E9",
        color="#2E7D32",
        fontcolor="#1B5E20"
    ];

    app -> acl -> driver -> hardware;
}
