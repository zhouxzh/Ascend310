digraph venc_channel_model {
    graph [
        rankdir=LR,
        bgcolor="transparent",
        dpi=300,
        pad=0.2,
        nodesep=0.65,
        ranksep=0.75
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Noto Sans CJK SC",
        fontsize=18,
        margin="0.20,0.12",
        penwidth=2,
        fillcolor="#F5F7FA",
        color="#607D8B",
        fontcolor="#263238"
    ];

    edge [
        color="#455A64",
        penwidth=2.3,
        arrowsize=0.8
    ];

    frame [label="NV12 Frame"];
    channel [label="VENC Channel", fillcolor="#E8F5E9", color="#2E7D32", fontcolor="#1B5E20"];
    bitstream [label="H.264 Bitstream"];

    frame -> channel -> bitstream;
}
