digraph accuracy_compare_flow {
    graph [
        rankdir=LR,
        bgcolor="transparent",
        dpi=300,
        pad=0.22,
        nodesep=0.42,
        ranksep=0.55
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Noto Sans CJK SC",
        fontsize=18,
        margin="0.18,0.12",
        penwidth=2
    ];

    edge [
        color="#455A64",
        penwidth=2.1,
        arrowsize=0.8
    ];

    val [
        label="data/val_list.txt\n10000 张 PNG 验证图",
        fillcolor="#E0F2F1",
        color="#00897B",
        fontcolor="#004D40"
    ];

    preprocess [
        label="同一套 CPU 预处理\nresize / normalize / NCHW",
        fillcolor="#ECEFF1",
        color="#546E7A",
        fontcolor="#263238"
    ];

    fp32 [
        label="FP32 OM\n精度基准",
        fillcolor="#E8EAF6",
        color="#3949AB",
        fontcolor="#1A237E"
    ];

    fp16 [
        label="FP16 OM\n第一阶段优化",
        fillcolor="#E3F2FD",
        color="#1976D2",
        fontcolor="#0D47A1"
    ];

    int8 [
        label="INT8 OM\n第二阶段优化",
        fillcolor="#FFF8E1",
        color="#F9A825",
        fontcolor="#E65100"
    ];

    report [
        label="accuracy_compare.json\nTop1 / Top5 / mean / p95",
        fillcolor="#FCE4EC",
        color="#C62828",
        fontcolor="#B71C1C"
    ];

    val -> preprocess;
    preprocess -> fp32;
    preprocess -> fp16;
    preprocess -> int8;
    fp32 -> report;
    fp16 -> report;
    int8 -> report;

    { rank=same; fp32; fp16; int8; }
}
