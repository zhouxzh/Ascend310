digraph tracking_pipeline {
	rankdir=TB;
	splines=polyline;
	nodesep=0.35;
	ranksep=0.45;

	graph [
		fontname="Noto Sans CJK SC",
		bgcolor="white",
		label="基于 MobileNet-SSD 与 DeepSORT 的目标跟踪流程",
		labelloc="t",
		fontsize=18
	];

	node [
		shape=box,
		style="rounded,filled",
		fontname="Noto Sans CJK SC",
		fontsize=11,
		color="#4C78A8",
		fillcolor="#EAF2FB",
		width=2.6,
		margin="0.14,0.10"
	];

	edge [
		color="#4C78A8",
		penwidth=1.4,
		arrowsize=0.8
	];

	input [label="视频输入\n摄像头/本地视频"];
	detect [label="目标检测\nMobileNet-SSD"];
	postprocess [label="检测结果后处理\n筛选、NMS、坐标解码"];
	predict [label="轨迹预测\n卡尔曼滤波"];
	associate [label="数据关联\n匈牙利匹配\nIoU/外观特征"];
	output [label="轨迹输出\n目标 ID 与轨迹信息"];

	input -> detect -> postprocess -> predict -> associate -> output;
}