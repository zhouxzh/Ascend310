# Copy the values you need into the current shell manually. This file is an
# example only and must never contain tokens, passwords, private keys, or real
# biometric paths.

# FastAPI listener. 0.0.0.0 is for an isolated trusted LAN only.
PALMPRINT_ROOT=
PALMPRINT_HOST=0.0.0.0
PALMPRINT_PORT=7860

# Ascend device and camera defaults.
PALMPRINT_NPU_DEVICE=0
PALMPRINT_CAMERA_DEVICE=/dev/video0
PALMPRINT_CAMERA_WIDTH=1280
PALMPRINT_CAMERA_HEIGHT=720
PALMPRINT_CAMERA_FPS=30
PALMPRINT_CAMERA_RESOLUTIONS=1280x720,1920x1080,640x480

# Used only by the offline asset downloader. Leave empty when downloading
# public assets without a mirror. Never commit a token in this file.
PALMPRINT_HF_ENDPOINT=

# Ignored by this internal-test release. Templates are local plaintext PWST1.
PALMPRINT_TEMPLATE_KEY_FILE=
# Ignored by this internal-test release. The directory is fixed to data/templates.
PALMPRINT_TEMPLATE_DIR=
# Kept only for compatibility with old shells; ignored by the current release.
PALMPRINT_REQUIRE_TEMPLATE_ENCRYPTION=0

# Interactive evaluation/resource limits. Full campaigns belong to the
# offline tools and are not started through the HTTP API.
PALMPRINT_JOB_TIMEOUT_SECONDS=900
PALMPRINT_MAX_JOB_TIMEOUT_SECONDS=3600
PALMPRINT_MAX_API_REPORT_FILES=120
PALMPRINT_MAX_API_REPORT_BYTES=536870912
