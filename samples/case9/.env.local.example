# Optional local-chat overrides. Copy to .env.local on the board only.
# The run script first loads .env for the authenticated gateway and then this
# file. Do not put GATEWAY_API_KEY in source control.
LOCAL_CHAT_HOST=0.0.0.0
LOCAL_CHAT_PORT=7862
LOCAL_GATEWAY_URL=http://127.0.0.1:7861/v1
LOCAL_GATEWAY_MODEL=case9-rag
LOCAL_LLM_TIMEOUT_SECONDS=90
LOCAL_MAX_MESSAGES=4
LOCAL_MAX_CHARACTERS=700

# Lightweight text-only browser test UI. It does not import audio/ASR/TTS.
# Optional: override the already-created board environment before launch.
# TEXT_CHAT_CONDA_ENV=case9-local-chat
TEXT_CHAT_HOST=0.0.0.0
TEXT_CHAT_PORT=7863
TEXT_CHAT_GATEWAY_URL=http://127.0.0.1:7861/v1
TEXT_CHAT_MODEL=case9-rag
TEXT_CHAT_LLM_TIMEOUT_SECONDS=300
TEXT_CHAT_BODY_TIMEOUT_SECONDS=15
TEXT_CHAT_WRITE_TIMEOUT_SECONDS=30
TEXT_CHAT_MAX_MESSAGES=4
TEXT_CHAT_MAX_CHARACTERS=700
TEXT_CHAT_MAX_CHARACTERS_CAP=768

# Candidate MindSpore UI (only when the board-side 8090/7867 chain is active).
# TEXT_CHAT_GATEWAY_URL=http://127.0.0.1:7867/v1
# TEXT_CHAT_MAX_CHARACTERS=4000
# TEXT_CHAT_MAX_CHARACTERS_CAP=4000
# TEXT_CHAT_MODEL_PROFILES=configs/chat_model_profiles.json
# TEXT_CHAT_ACTIVE_PROFILE_STATE=run/mindspore-chat/active-model.json

# PulseAudio names, not mutable ALSA card numbers.
LOCAL_CHAT_PULSE_SOURCE=alsa_input.usb-046d_C922_Pro_Stream_Webcam_B7E0139F-02.analog-stereo
LOCAL_CHAT_PULSE_SINK=alsa_output.usb-Jieli_Technology_UACDemoV1.0_4150344637353804-00.analog-stereo
AUDIO_MAX_DURATION_SECONDS=30
