# This gateway accepts XiaoZhi-server requests with this Bearer token.
# Generate a unique, high-entropy value; do not commit the populated .env file.
GATEWAY_API_KEY=replace-with-a-random-long-token

# The board-local no-Torch ACL/OM server. Its /v1/chat/completions endpoint is used.
UPSTREAM_BASE_URL=http://127.0.0.1:8080/v1
# Leave empty for the board-local loopback policy. Non-loopback hosts require
# an explicit comma-separated allowlist and should only be used in a reviewed
# private deployment.
UPSTREAM_ALLOWED_HOSTS=
UPSTREAM_API_KEY=
UPSTREAM_MODEL=qwen2.5-0.5b-instruct-static-kv-1024-fp32-acl-om

# Candidate reproduction only; the formal board process uses 8080/7861/7865.
# The historical Qwen2.5 candidate used 8084. The new MindSpore Profile
# candidate uses 8090/7867/7868 and one active profile at a time.
# UPSTREAM_BASE_URL=http://127.0.0.1:8090/v1
# UPSTREAM_MODEL=case9-active
# RAG_ENABLED=false
# MAX_CONCURRENT_REQUESTS=1
# REQUEST_MAX_CHARACTERS=4000

# XiaoZhi calls this virtual model name; the gateway maps it to UPSTREAM_MODEL.
PUBLIC_MODEL_ID=case9-rag
UPSTREAM_TIMEOUT_SECONDS=270

# Request and retrieval limits.
REQUEST_MAX_BYTES=262144
REQUEST_BODY_TIMEOUT_SECONDS=15
REQUEST_MAX_MESSAGES=32
REQUEST_MAX_CHARACTERS=24000
MAX_CONCURRENT_REQUESTS=1
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
STREAM_MAX_SECONDS=270
STREAM_WRITE_TIMEOUT_SECONDS=30
STREAM_MAX_BYTES=2097152
RAG_ENABLED=false
RAG_DOCUMENTS_DIR=knowledge
RAG_TOP_K=3
RAG_MIN_SCORE=0.08
RAG_MAX_CONTEXT_CHARACTERS=5000
LOG_LEVEL=INFO

# MindSpore candidate controls (board shell only; no model path or secret is
# accepted from an HTTP request). The launcher pins the loopback endpoint and
# reads the validated registry under configs/chat_model_profiles.json.
# CASE9_MINDSPORE_CONDA_ENV=base
# CASE9_MODEL_ROOT=/home/HwHiAiUser/case9-mindspore-chat
# CASE9_ACTIVE_PROFILE=qwen1.5-0.5b-mindspore
# MINDSPORE_CHAT_HOST=127.0.0.1
# MINDSPORE_CHAT_PORT=8090
