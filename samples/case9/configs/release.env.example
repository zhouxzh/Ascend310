# Copy to .env on the board and replace the token before starting services.
ASCEND_EDGE_CHAT_GATEWAY_API_KEY=replace-with-a-random-long-token
ASCEND_EDGE_CHAT_UPSTREAM_BASE_URL=http://127.0.0.1:8090/v1
ASCEND_EDGE_CHAT_UPSTREAM_API_KEY=
ASCEND_EDGE_CHAT_UPSTREAM_MODEL=ascend-edge-chat-worker
ASCEND_EDGE_CHAT_MAX_CONCURRENT_REQUESTS=1
ASCEND_EDGE_CHAT_UPSTREAM_TIMEOUT_SECONDS=300
ASCEND_EDGE_CHAT_STREAM_MAX_SECONDS=300
ASCEND_EDGE_CHAT_DATA_DIR=/opt/ascend-edge-chat-data
ASCEND_EDGE_CHAT_ALLOW_PREVIEW=1
ASCEND_EDGE_CHAT_GENERATION_TIMEOUT=300
ASCEND_EDGE_CHAT_PROFILE=qwen1.5-0.5b-chat
# Every case uses the shared user-owned conda environment `ascend`.
# Python is fixed at 3.9.25; never fall back to base or pip --user.
ASCEND_EDGE_CHAT_CONDA_ENV=ascend
ASCEND_EDGE_CHAT_MODEL_CATALOG=/opt/ascend-edge-chat/configs/tutorial-model-catalog.json
ASCEND_EDGE_CHAT_DEVICE_TARGET=Ascend
ASCEND_EDGE_CHAT_DEVICE_ID=0
# Optional MindSpore context cap in the exact form required by set_context,
# for example 4GB. Leave empty to use MindSpore's default allocation policy.
ASCEND_EDGE_CHAT_MAX_DEVICE_MEMORY=
# MindSpore 2.4.10 exposes context/NPU evidence but not parameter placement.
ASCEND_EDGE_CHAT_ALLOW_CONTEXT_PLACEMENT=1
ASCEND_EDGE_CHAT_REQUIRE_PLACEMENT_EVIDENCE=1

# The browser UI is intentionally unauthenticated and intended for a trusted LAN.
ASCEND_EDGE_CHAT_UI_HOST=0.0.0.0
ASCEND_EDGE_CHAT_UI_PORT=7865

# Voice control is disabled until USB/3.5 mm I/O, the audio group, ASR/TTS
# artifacts, and their separate 20T acceptance gates have passed.
ASCEND_EDGE_CHAT_VOICE_ENABLED=false
ASCEND_EDGE_CHAT_VOICE_MODE=disabled
ASCEND_EDGE_CHAT_VOICE_AGENT_URL=http://127.0.0.1:7862
ASCEND_EDGE_CHAT_VOICE_CONTROL_TIMEOUT_SECONDS=5

# The board-owned agent uses the same shared `ascend` environment. Its gateway
# key must match the gateway token above, but clients never receive it.
ASCEND_EDGE_CHAT_VOICE_CONDA_ENV=ascend
ASCEND_EDGE_CHAT_VOICE_HOST=127.0.0.1
ASCEND_EDGE_CHAT_VOICE_PORT=7862
ASCEND_EDGE_CHAT_VOICE_GATEWAY_URL=http://127.0.0.1:7861/v1
ASCEND_EDGE_CHAT_VOICE_GATEWAY_API_KEY=replace-with-the-same-random-long-token
ASCEND_EDGE_CHAT_VOICE_CAPTURE_SAMPLE_RATE_HZ=16000
# 0 captures stereo then downmixes in memory; set 1 only after ALSA device inspection.
ASCEND_EDGE_CHAT_VOICE_CAPTURE_DEVICE_CHANNELS=0
ASCEND_EDGE_CHAT_VOICE_PLAYBACK_SAMPLE_RATE_HZ=22050
ASCEND_EDGE_CHAT_VOICE_FRAME_MS=20
ASCEND_EDGE_CHAT_VOICE_SPEECH_RMS_THRESHOLD=450
ASCEND_EDGE_CHAT_VOICE_START_SPEECH_FRAMES=3
ASCEND_EDGE_CHAT_VOICE_STOP_SILENCE_MS=800
ASCEND_EDGE_CHAT_VOICE_MAX_CAPTURE_SECONDS=30
ASCEND_EDGE_CHAT_VOICE_MAX_TEXT_CHARACTERS=1200
ASCEND_EDGE_CHAT_VOICE_MAX_BROWSER_AUDIO_BYTES=1048576
# Start fail-closed until a reviewed local speech runtime and locked artifacts
# are supplied. Never replace this with a cloud backend or an implicit download.
ASCEND_EDGE_CHAT_VOICE_SPEECH_BACKEND=unavailable
# A unified environment may select the system eSpeak NG test backend explicitly:
# ASCEND_EDGE_CHAT_VOICE_TTS_BACKEND=espeak-ng
# ASCEND_EDGE_CHAT_VOICE_ESPEAK_NG_VOICE=cmn
# ASCEND_EDGE_CHAT_VOICE_ESPEAK_NG_SPEED=160
# For the later approved sherpa-onnx backend only:
# ASCEND_EDGE_CHAT_VOICE_SPEECH_BACKEND=sherpa-onnx
# ASCEND_EDGE_CHAT_VOICE_SHERPA_ASR_MODEL_DIR=/opt/ascend-edge-chat-data/voice/asr
# ASCEND_EDGE_CHAT_VOICE_SHERPA_TTS_MODEL_DIR=/opt/ascend-edge-chat-data/voice/tts
# ASCEND_EDGE_CHAT_VOICE_SHERPA_NUM_THREADS=2
# This teaching example has no additional voice-operation token. The agent is
# loopback-only; device selection remains limited to its enumerated allowlist.
