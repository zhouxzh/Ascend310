# Copy to .env on the board and replace the token before starting services.
ASCEND_EDGE_CHAT_GATEWAY_API_KEY=replace-with-a-random-long-token
ASCEND_EDGE_CHAT_UPSTREAM_BASE_URL=http://127.0.0.1:8090/v1
ASCEND_EDGE_CHAT_UPSTREAM_API_KEY=
ASCEND_EDGE_CHAT_UPSTREAM_MODEL=ascend-edge-chat-worker
ASCEND_EDGE_CHAT_MAX_CONCURRENT_REQUESTS=1
ASCEND_EDGE_CHAT_UPSTREAM_TIMEOUT_SECONDS=300
ASCEND_EDGE_CHAT_STREAM_MAX_SECONDS=300
ASCEND_EDGE_CHAT_DATA_DIR=/opt/ascend-edge-chat-data
ASCEND_EDGE_CHAT_ALLOW_PREVIEW=1
ASCEND_EDGE_CHAT_GENERATION_TIMEOUT=300
ASCEND_EDGE_CHAT_DEVICE_TARGET=Ascend
ASCEND_EDGE_CHAT_DEVICE_ID=0
# MindSpore 2.4.10 exposes context/NPU evidence but not parameter placement.
ASCEND_EDGE_CHAT_ALLOW_CONTEXT_PLACEMENT=1
ASCEND_EDGE_CHAT_REQUIRE_PLACEMENT_EVIDENCE=1

# The browser UI is intentionally unauthenticated and intended for a trusted LAN.
ASCEND_EDGE_CHAT_UI_HOST=0.0.0.0
ASCEND_EDGE_CHAT_UI_PORT=7865
