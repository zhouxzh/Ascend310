# Copy to .env on the Ascend310B4 board and replace the gateway token.
ASCEND_EDGE_CHAT_GATEWAY_API_KEY=replace-with-a-random-long-token
ASCEND_EDGE_CHAT_BACKEND=acl-static-kv
ASCEND_EDGE_CHAT_UPSTREAM_BASE_URL=http://127.0.0.1:8084/v1
ASCEND_EDGE_CHAT_UPSTREAM_API_KEY=
ASCEND_EDGE_CHAT_UPSTREAM_MODEL=qwen2.5-0.5b-instruct-static-kv-1024-fp32-acl-om
ASCEND_EDGE_CHAT_UPSTREAM_TIMEOUT_SECONDS=330
ASCEND_EDGE_CHAT_STREAM_MAX_SECONDS=330
ASCEND_EDGE_CHAT_MAX_CONCURRENT_REQUESTS=1
ASCEND_EDGE_CHAT_MODEL_SOURCE=hf

# All chat processes use the shared user-owned environment.
ASCEND_EDGE_CHAT_CONDA_ENV=ascend
ASCEND_EDGE_CHAT_DEVICE_TARGET=Ascend
ASCEND_EDGE_CHAT_DEVICE_ID=0
ASCEND_EDGE_CHAT_PROFILE=qwen2.5-0.5b-instruct-static-kv-1024-fp32-acl-om
ASCEND_EDGE_CHAT_MODEL_CATALOG=/opt/ascend-edge-chat/configs/release-8t-model-catalog.json

# The formal 8T assets are downloaded and verified into this data directory.
ASCEND_EDGE_CHAT_DATA_DIR=/opt/ascend-edge-chat-data-8t
ASCEND_EDGE_CHAT_ACL_LOCK=/opt/ascend-edge-chat/configs/release-8t-static-kv.lock.json
ASCEND_EDGE_CHAT_ACL_HOST=127.0.0.1
ASCEND_EDGE_CHAT_ACL_PORT=8084
ASCEND_EDGE_CHAT_ACL_MAX_TOKENS=80
ASCEND_EDGE_CHAT_ACL_EXECUTION_TIMEOUT_SECONDS=240

# The UI observes the external ACL service and must not manage or switch workers.
ASCEND_EDGE_CHAT_UI_WORKER_MODE=external
ASCEND_EDGE_CHAT_UI_WORKER_HEALTH_URL=http://127.0.0.1:8084/health
ASCEND_EDGE_CHAT_UI_HOST=0.0.0.0
ASCEND_EDGE_CHAT_UI_PORT=7865
ASCEND_EDGE_CHAT_UI_LLM_TIMEOUT_SECONDS=300

# Voice remains a separate capability and is disabled in the text release.
ASCEND_EDGE_CHAT_VOICE_ENABLED=false
ASCEND_EDGE_CHAT_VOICE_MODE=disabled
