# Ascend310B4/8T board profile for the shared chat application.
# Copy to .env, replace the gateway token, then run scripts/run/run-chat.sh.
ASCEND_EDGE_CHAT_GATEWAY_API_KEY=replace-with-a-random-long-token
ASCEND_EDGE_CHAT_BACKEND=mindspore
ASCEND_EDGE_CHAT_UPSTREAM_BASE_URL=http://127.0.0.1:8090/v1
ASCEND_EDGE_CHAT_UPSTREAM_API_KEY=
ASCEND_EDGE_CHAT_UPSTREAM_MODEL=ascend-edge-chat-worker
ASCEND_EDGE_CHAT_UPSTREAM_TIMEOUT_SECONDS=300
ASCEND_EDGE_CHAT_STREAM_MAX_SECONDS=300
ASCEND_EDGE_CHAT_MAX_CONCURRENT_REQUESTS=1
ASCEND_EDGE_CHAT_MODEL_SOURCE=hf
ASCEND_EDGE_CHAT_DATA_DIR=/opt/ascend-edge-chat-data-8t
ASCEND_EDGE_CHAT_PROFILE=qwen1.5-0.5b-chat
ASCEND_EDGE_CHAT_CONDA_ENV=ascend
ASCEND_EDGE_CHAT_MODEL_CATALOG=/opt/ascend-edge-chat/configs/release-model-catalog.json
ASCEND_EDGE_CHAT_BACKEND_SUPERVISOR_URL=http://127.0.0.1:7863
ASCEND_EDGE_CHAT_BACKEND_SUPERVISOR_PORT=7863
ASCEND_EDGE_CHAT_ACL_CANDIDATE_CATALOG=/opt/ascend-edge-chat/configs/8t-backend-catalog.json
ASCEND_EDGE_CHAT_ACL_CANDIDATE_DATA_DIR=/opt/ascend-edge-chat-acl-b4
ASCEND_EDGE_CHAT_DEVICE_TARGET=Ascend
ASCEND_EDGE_CHAT_DEVICE_ID=0
ASCEND_EDGE_CHAT_MIN_ACCOUNTED_FREE_HBM_MB_8T=6144
ASCEND_EDGE_CHAT_ALLOW_CONTEXT_PLACEMENT=1
ASCEND_EDGE_CHAT_REQUIRE_PLACEMENT_EVIDENCE=1
ASCEND_EDGE_CHAT_UI_HOST=0.0.0.0
ASCEND_EDGE_CHAT_UI_PORT=7865
ASCEND_EDGE_CHAT_UI_WORKER_MODE=managed
ASCEND_EDGE_CHAT_UI_LLM_TIMEOUT_SECONDS=300
ASCEND_EDGE_CHAT_VOICE_ENABLED=false
ASCEND_EDGE_CHAT_VOICE_MODE=disabled

# Optional PyACL static-KV candidate paths are separate from the MindSpore
# default model and are used only by the allowlisted backend supervisor entry.
