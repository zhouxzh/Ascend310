# Secrets, board artifacts, and reproducibility outputs never enter Git.
.env
.env.local

# Downloaded or converted models and their board-side contracts/reports.
/artifacts/
/contracts/
/reports/
/models/
/repro/
*.om
*.onnx
*.safetensors
*.part

# Runtime state, caches, and generated Python files.
/run/
__pycache__/
*.py[cod]
