digraph architecture_16x9 {
  graph [
    rankdir=TB,
    fontname="Noto Sans CJK SC",
    fontsize=16,
    size="8.5,4.8",
    ratio="fill",
    dpi=144,
    pad="0.08",
    nodesep="0.28",
    ranksep="0.42",
    splines="polyline",
    bgcolor="transparent"
  ];
  node [
    fontname="Noto Sans CJK SC",
    fontsize=16,
    margin="0.14,0.10",
    height="0.56",
    shape=box,
    style="rounded,filled",
    fillcolor="#F5F7FA",
    color="#607D8B"
  ];
  edge [
    fontname="Noto Sans CJK SC",
    fontsize=13,
    color="#546E7A",
    arrowsize="0.7"
  ];

  browser [label="<客户端>\n<网络边界>", fillcolor="#E8F5E9"];
  ui [label="<界面/服务> :<端口>\n<认证方式>", fillcolor="#E3F2FD"];
  gateway [label="<网关/接入层> :<端口>\n<协议>"];
  worker [label="<执行服务>\n<并发或串行>", fillcolor="#E8F5E9"];
  model [label="<模型加载>\n<输出合同>", shape=note];
  npu [label="<板卡型号> / <档位>", fillcolor="#FFF3E0"];

  { rank=same; browser; ui; }
  { rank=same; gateway; worker; }
  { rank=same; model; npu; }

  browser -> ui [label="<协议>"];
  ui -> gateway [label="<路由/回环>"];
  gateway -> worker [label="<请求合同>"];
  worker -> model [label="<模型/版本>"];
  model -> npu [label="<设备>"];
}
